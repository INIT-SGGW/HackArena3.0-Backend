# Application environment: development | preprod | production
APP_ENV=development

# gRPC server listen address
LISTEN_ADDR=0.0.0.0:50051

# Logging
RUST_LOG=warn,boink=info,tonic_web=info,game_server=info,game_engine=info,game_server::config=debug

# Allowed CORS origins
CORS_ALLOWED_ORIGINS=

# Optional: additional headers to expose (comma-separated)
# CORS_EXPOSE_HEADERS=X-Trace-Id

# HackArena Platform Service endpoint
HPS_ENDPOINT=

# Public API base URL
API_URL=https://ha3-api.hackarena.pl

# Directory containing maps exposed for local backend sync over AssetService.
# When unset, local map assets are not served.
# LOCAL_TRACKS_DIR=

# Game-token JWT settings used by `ha3-backend-official`
GAME_JWT_OFFICIAL_AUDIENCE=ha3-official
GAME_JWT_OFFICIAL_ISSUERS=ha3-auth

# Official backend database URL (Postgres)
OFFICIAL_DATABASE_URL=postgres://user:pass@localhost:5432/ha3_official_dev

# Optional: max size of the official DB connection pool
# OFFICIAL_DB_MAX_CONNECTIONS=8

# Remote builder host (SSH target, user is hardcoded to root)
BUILDER_HOST=localhost
BUILDER_SSH_KEY_PATH=C:/path/to/ha3_builder_ed25519
BUILDER_SSH_KNOWN_HOSTS_FILE=.submissions/known_hosts

# Container registry used for pushed submission images
REGISTRY=localhost:5000

# Keycloak token endpoint for service-to-service auth
KEYCLOAK_TOKEN_URL=https://auth.example.com/realms/{realm}/protocol/openid-connect/token

# Keycloak client credentials used with grant_type=client_credentials
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Endpoint przekazywany do wrappera bota w kontenerze
OFFICIAL_BOT_BACKEND_ENDPOINT=https://ha3-api.hackarena.pl/backend

# GitHub repository used to fetch private wrapper wheel assets
WRAPPER_GH_OWNER=
WRAPPER_GH_REPO=

# Maximum accepted submission archive size in megabytes
SUBMISSION_ARCHIVE_MAX_MB=25

# End-to-end timeout for submission build job in seconds
SUBMISSION_BUILD_TIMEOUT_SEC=1800
