# Application environment: development | production
APP_ENV=development

# gRPC server listen address
LISTEN_ADDR=0.0.0.0:50051

# Allowed CORS origins:
#  - use "*" for any origin (recommended only in development)
#  - or comma-separated list: "http://localhost:3000, https://example.com"
CORS_ALLOWED_ORIGINS=

# Optional: additional headers to expose (comma-separated)
# CORS_EXPOSE_HEADERS=X-Trace-Id
